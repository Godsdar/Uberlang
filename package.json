{
  "name": "lingua-ts",
  "version": "0.1.0",
  "description": "Uberlang — translation and the Indo-European language tree",
  "author": "Uberlang",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:server",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "node --test src/core/*.test.ts web/concept/domain/*.test.mjs && npm run test:server",
    "build:ext": "vite build --config extension/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dev:server": "node --watch server/src/index.ts",
    "build:server": "vite build --config server/vite.config.ts",
    "start:server": "node server-dist/index.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:server": "node --no-experimental-require-module --test server/test/*.test.ts",
    "smoke:server": "node server/smoke.mjs && node --test server/socket-smoke.ts",
    "dev:api": "node --watch server/src/public-dev.ts",
    "build:gateway": "vite build --config server/vite.gateway.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "6.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "d3-hierarchy": "^3.1.2",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "htmlparser2": "12.0.0",
    "motion": "^13.5.0",
    "sql.js": "1.15.1",
    "tinyld": "1.3.4"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
