{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web && npm run build:gateway",
  "outputDirectory": "web/dist",
  "installCommand": "npm ci",
  "functions": {
    "api/engine.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,docs/**,web/**,src/**,server/**,out/**,extension/**,.git/**}"
    },
    "api/analysis.mjs": {
      "maxDuration": 30
    },
    "api/etymology.mjs": {
      "maxDuration": 30
    },
    "api/lexicon.mjs": {
      "maxDuration": 30
    },
    "api/health.mjs": {
      "maxDuration": 5
    }
  }
}
